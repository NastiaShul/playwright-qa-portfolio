# Firebase web API keys
FIREBASE_API_KEY=
BT_FIREBASE_API_KEY=

# Test accounts
USER_EMAIL=
USER_PASSWORD=
USER2_EMAIL=
USER2_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
EMPTY_USER_EMAIL=
EMPTY_USER_PASSWORD=
DELETE_USER1_EMAIL=
DELETE_USER2_EMAIL=
